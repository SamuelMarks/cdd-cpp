#!/bin/bash
set -e

# Format code
echo "Formatting code..."
find src -name '*.cpp' -o -name '*.hpp' | xargs clang-format -i

# Recheck formatting
if ! git diff --quiet src/; then
    echo "Formatting changed files. Staging formatting fixes..."
    git add src/
    echo "Files automatically formatted and staged. Please commit again."
    exit 1
fi

# Lint code
echo "Linting code..."
find src -name '*.cpp' -o -name '*.hpp' | xargs cpplint --filter=-legal/copyright,-build/include_order,-build/include_subdir,-whitespace/comments,-build/include_what_you_use,-build/namespaces,-build/c++17,-readability/casting,-whitespace/indent,-whitespace/ending_newline,-readability/braces,-whitespace/blank_line,-build/include,-whitespace/newline,-readability/todo --linelength=120

# Run build
echo "Building project..."
make build || { echo "Build failed. Commit aborted."; exit 1; }

# Run tests
echo "Running tests..."
make test || { echo "Tests failed. Commit aborted."; exit 1; }

# Calculate coverage
echo "Calculating coverage..."
test_cov=$(python3 tools/test_coverage.py || echo "0")
doc_cov=$(python3 tools/doc_coverage.py src || echo "0")

# Update README badges
python3 tools/update_badges.py "$test_cov" "$doc_cov"

# Add README to the commit if it was updated
if ! git diff --quiet README.md; then
    git add README.md
fi

cleanup() {
    if command -v docker >/dev/null 2>&1; then
        docker rm -f petstore_server_v2 >/dev/null 2>&1 || true
        docker rm -f petstore_server_v3 >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

# Swagger 2.0 Petstore test
echo "Running Swagger 2.0 Petstore test..."
rm -rf ../cdd-cpp-client-v2
./build/cdd-cpp from_openapi to_sdk -i ../petstore.json -o ../cdd-cpp-client-v2 --tests || { echo "Swagger 2.0 SDK generation failed."; exit 1; }
if command -v docker >/dev/null 2>&1; then
    docker rm -f petstore_server_v2 >/dev/null 2>&1 || true
    docker run -d -p 8080:8080 -e SWAGGER_HOST="http://localhost:8080" -e SWAGGER_BASE_PATH="/v2" --name petstore_server_v2 swaggerapi/petstore >/dev/null 2>&1 || true
    echo "Waiting for Swagger 2.0 Petstore to start..."
    for i in {1..30}; do
        if curl -s -f -o /dev/null http://localhost:8080/v2/swagger.json; then
            break
        fi
        sleep 5
    done
fi
(cd ../cdd-cpp-client-v2 && cmake . -DFETCHCONTENT_UPDATES_DISCONNECTED=ON && cmake --build . && PETSTORE_URL="http://localhost:8080/v2" ./tests/client_test) || { echo "Swagger 2.0 tests failed."; exit 1; }
if command -v docker >/dev/null 2>&1; then
    docker rm -f petstore_server_v2 >/dev/null 2>&1 || true
fi

# OpenAPI 3.2.0 Petstore test
echo "Running OpenAPI 3.2.0 Petstore test..."
rm -rf ../cdd-cpp-client-v3
./build/cdd-cpp from_openapi to_sdk -i ../petstore_oas3.json -o ../cdd-cpp-client-v3 --tests || { echo "OpenAPI 3.2.0 SDK generation failed."; exit 1; }
if command -v docker >/dev/null 2>&1; then
    docker rm -f petstore_server_v3 >/dev/null 2>&1 || true
    docker run -d -p 8080:8080 -e SWAGGER_HOST="http://localhost:8080" -e SWAGGER_BASE_PATH="/api/v3" --name petstore_server_v3 swaggerapi/petstore >/dev/null 2>&1 || true
    echo "Waiting for OpenAPI 3.2.0 Petstore to start..."
    for i in {1..30}; do
        if curl -s -f -o /dev/null http://localhost:8080/api/v3/openapi.json; then
            break
        fi
        sleep 5
    done
fi
(cd ../cdd-cpp-client-v3 && cmake . -DFETCHCONTENT_UPDATES_DISCONNECTED=ON && cmake --build . && PETSTORE_URL="http://localhost:8080/api/v3" ./tests/client_test) || { echo "OpenAPI 3.2.0 tests failed."; exit 1; }
if command -v docker >/dev/null 2>&1; then
    docker rm -f petstore_server_v3 >/dev/null 2>&1 || true
fi

# WASM build test
echo "Building WASM..."
if [ -f "make.bat" ]; then
    make build_wasm || { echo "WASM build failed. Commit aborted."; exit 1; }
else
    make build_wasm || { echo "WASM build failed. Commit aborted."; exit 1; }
fi

echo "Pre-commit checks passed."."